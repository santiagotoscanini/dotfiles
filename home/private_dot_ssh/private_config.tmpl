# ~/.ssh/config
# Managed by chezmoi: edit home/private_dot_ssh/private_config.tmpl in the repo.
# The key itself is created by .chezmoiscripts/run_onchange_after_20-ssh-and-github.sh.tmpl
# (name in .chezmoidata/ssh.yaml).

# Machine-only hosts go in ~/.ssh/config.local (not tracked). The Include must
# come before any Host line, or it would only apply inside that Host block.
Include ~/.ssh/config.local

Host github.com
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/{{ .ssh.key }}
{{- if dig "s2" false . }}

# Home server; its key comes from Proton Pass (.chezmoiscripts, ssh.yaml).
# Away from home, s2-proxy carries just this session through WireGuard.
Host s2
  HostName {{ .ssh.s2.host }}
  User {{ .ssh.s2.user }}
  IdentitiesOnly yes
  IdentityFile ~/.ssh/{{ .ssh.s2.key }}
  ProxyCommand ~/.local/bin/s2-proxy %h %p
  # Every session shares one connection (one wireproxy): two WireGuard
  # clients with the same key would fight. Stays up 10 min after the last one.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
{{- end }}
