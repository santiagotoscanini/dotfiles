# ~/.ssh/config
# Managed by chezmoi: edit home/private_dot_ssh/private_config.tmpl in the repo.
# The key itself is created by .chezmoiscripts/run_onchange_after_20-ssh-key.sh
# (name in .chezmoidata/ssh.yaml).

# Machine-only hosts go in ~/.ssh/config.local (not tracked). The Include must
# come before any Host line, or it would only apply inside that Host block.
Include ~/.ssh/config.local

Host github.com
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/{{ .ssh.key }}
{{- if eq .profile "personal" }}

# Home server
Host s2
  HostName 192.168.0.2
  User santiago
{{- end }}
