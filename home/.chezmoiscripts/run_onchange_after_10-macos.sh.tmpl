{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# macOS setup: the folders other configs expect, the preferences listed in
# .chezmoidata/macos.yaml, and on mobile development machines, Xcode.
# run_onchange: every value is embedded below, so editing macos.yaml or
# folders.yaml, or changing the mobile answer, re-runs this on the next
# `chezmoi apply`.
{{ template "script-prelude.sh" . }}

log "Creating folders"
mkdir -p \
  {{ joinPath .chezmoi.homeDir .devDir "personal" | quote }} \
  {{ joinPath .chezmoi.homeDir .devDir "work" | quote }} \
  {{ joinPath .chezmoi.homeDir "Documents" "Screenshots" | quote }}

log "Applying macOS preferences"
{{ range .macos.defaults -}}
{{- $value := .value | toString -}}
{{- if hasPrefix "~/" $value }}{{ $value = joinPath $.chezmoi.homeDir (trimPrefix "~/" $value) }}{{ end }}
echo "    {{ .why }}"
defaults write {{ .domain | quote }} {{ .key | quote }} -{{ .type }} {{ $value | quote }}
{{ end }}
{{- range .macos.restart }}
killall {{ . | quote }} >/dev/null 2>&1 || true
{{- end }}

{{- if dig "mobileDev" false . }}

# Mobile development: point the developer tools at Xcode (the Command Line
# Tools have no simulator), accept its license, install its first-launch
# components and the iOS Simulator. Each step is skipped once done. When one
# can't run yet, the script fails so chezmoi runs it again on the next apply.
xcode=/Applications/Xcode.app/Contents/Developer
if [ ! -d "$xcode" ]; then
  warn "Xcode is not installed yet (Brewfile, App Store sign-in); the next \`chezmoi apply\` sets it up"
  exit 1
elif [ "$(xcode-select -p)" = "$xcode" ] && xcodebuild -license check >/dev/null 2>&1 \
  && xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1; then
  log "Xcode is set up"
elif [ ! -t 0 ]; then
  warn "Xcode needs sudo to finish setting up; run \`chezmoi apply\` from a terminal"
  exit 1
else
  log "Setting up Xcode (asks for your password)"
  [ "$(xcode-select -p)" = "$xcode" ] || sudo xcode-select --switch "$xcode"
  xcodebuild -license check >/dev/null 2>&1 || sudo xcodebuild -license accept
  xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1 || sudo xcodebuild -runFirstLaunch
fi
if ! xcrun simctl list runtimes 2>/dev/null | grep -q '^iOS'; then
  log "Downloading the iOS Simulator (several GB)"
  xcodebuild -downloadPlatform iOS
fi
{{- end }}
{{ end -}}
