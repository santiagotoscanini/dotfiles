#!/bin/bash
# The machine's SSH key, used for both git over SSH and commit signing:
#   1. create ~/.ssh/{{ .ssh.key }} if it's missing (never touches an existing key)
#   2. write ~/.ssh/allowed_signers so git can verify my own signed commits
#   3. log in to GitHub with gh if needed (opens a browser)
#   4. upload the key as an authentication key and as a signing key, only
#      where GitHub doesn't have it yet
#   5. trust GitHub's SSH host keys in ~/.ssh/known_hosts, so the first
#      `git push` doesn't fail with "Host key verification failed"
#   6. install the gh extensions listed below, where they're missing
#   7. if this machine connects to S2, copy the home server's key from
#      Proton Pass to ~/.ssh/{{ .ssh.s2.key }} (logs in to pass-cli if needed)
#      and trust S2's host key in ~/.ssh/known_hosts
#
# run_onchange: re-runs when the key name, emails, GitHub user, S2 answer,
# S2 host key or the extension list change.
# If the GitHub part fails (no browser, declined login), the next
# `chezmoi apply` tries again. Runs last so it never blocks the rest.
{{ template "script-prelude.sh" . }}

ssh_dir={{ joinPath .chezmoi.homeDir ".ssh" | quote }}
key="$ssh_dir/{{ .ssh.key }}"

# ---- 1. Key ----
mkdir -p "$ssh_dir" && chmod 700 "$ssh_dir"
if [ ! -f "$key" ]; then
  log "Generating SSH key ~/.ssh/{{ .ssh.key }}"
  ssh-keygen -t {{ .ssh.type | quote }} -f "$key" -N "" -C {{ .identity.email | quote }}
fi
pubkey="$(cut -d' ' -f1,2 "$key.pub")"   # "<type> <base64>", comment dropped

# ---- 2. allowed_signers ----
{
{{- range (list .identity.email .workEmail | compact) }}
  printf '%s namespaces="git" %s\n' {{ . | quote }} "$pubkey"
{{- end }}
} > "$ssh_dir/allowed_signers"

# ---- 3. GitHub login ----
# --skip-ssh-key: gh would upload the key itself, as auth only; step 4
# uploads it both ways.
scopes="admin:public_key,admin:ssh_signing_key"
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
  if [ ! -t 0 ]; then
    warn "Not logged in to GitHub; run \`chezmoi apply\` from a terminal to log in"
    exit 1
  fi
  log "Logging in to GitHub (a browser window will open)"
  gh auth login --hostname github.com --git-protocol ssh --web --skip-ssh-key --scopes "$scopes"
elif [[ "$(gh auth status --hostname github.com 2>&1)" != *admin:ssh_signing_key* ]]; then
  log "Granting gh permission to manage SSH keys (a browser window will open)"
  gh auth refresh --hostname github.com --scopes "$scopes"
fi

login="$(gh api user --jq .login)"
[ "$login" = {{ .identity.github | quote }} ] \
  || warn "gh is logged in as $login, not {{ .identity.github }}; uploading to $login"

# ---- 4. Upload ----
# Mac name plus account: several accounts on one Mac each upload their own key.
title="$(scutil --get ComputerName 2>/dev/null || hostname -s) ($(id -un))"
upload_if_missing() { # <type> <api endpoint listing that type of key>
  # Capture first: piping into `grep -q` can fail under pipefail (SIGPIPE).
  local existing
  existing="$(gh api --paginate "$2" --jq '.[].key')"
  if grep -qxF "$pubkey" <<<"$existing"; then
    echo "    already on GitHub as $1 key"
  else
    log "Uploading ~/.ssh/{{ .ssh.key }}.pub to GitHub as $1 key ($title)"
    gh ssh-key add "$key.pub" --type "$1" --title "$title"
  fi
}
upload_if_missing authentication user/keys
upload_if_missing signing user/ssh_signing_keys

# ---- 5. GitHub host keys ----
# gh and the uploads above use HTTPS, so nothing has connected over SSH yet
# and known_hosts has no github.com entry. Without one, non-interactive git
# (scripts, agents, editors) refuses to connect. The keys come from GitHub's
# API over authenticated HTTPS, which is a trusted channel; ssh-keyscan would
# accept whatever host answers. Appends only missing keys, so it also picks
# up keys GitHub rotates in.
known_hosts="$ssh_dir/known_hosts"
touch "$known_hosts" && chmod 600 "$known_hosts"
while read -r hostkey; do
  if ! grep -qxF "github.com $hostkey" "$known_hosts"; then
    log "Trusting GitHub host key ${hostkey%% *}"
    printf 'github.com %s\n' "$hostkey" >> "$known_hosts"
  fi
done < <(gh api meta --jq '.ssh_keys[]')

# ---- 6. gh extensions ----
# gh-stack: stacked branches and pull requests (`gh stack`).
installed="$(gh extension list)"
for ext in github/gh-stack; do
  if ! grep -qF "$ext" <<<"$installed"; then
    log "Installing the gh extension $ext"
    gh extension install "$ext"
  fi
done
{{- if dig "s2" false . }}

# ---- 7. S2 home server key ----
# One shared key, kept in Proton Pass instead of generated per machine, so a
# new Mac logs in without touching the server. Never overwrites a key that's
# already there.
s2_key="$ssh_dir/{{ .ssh.s2.key }}"
if [ ! -f "$s2_key" ]; then
  if ! pass-cli info >/dev/null 2>&1; then
    if [ ! -t 0 ]; then
      warn "Not logged in to Proton Pass; run \`chezmoi apply\` from a terminal to fetch the S2 key"
      exit 1
    fi
    log "Logging in to Proton Pass (open the link it prints)"
    pass-cli login
  fi
  log "Copying the S2 key from Proton Pass to ~/.ssh/{{ .ssh.s2.key }}"
  tmp="$(mktemp "$ssh_dir/.s2.XXXXXX")"   # mktemp creates it 0600
  trap 'rm -f "$tmp"' EXIT
  pass-cli item view {{ printf "%s/%s" .ssh.s2.item .ssh.s2.field | quote }} > "$tmp"
  # Fails on anything that isn't a valid private key, before it's installed.
  ssh-keygen -y -f "$tmp" > "$s2_key.pub"
  mv "$tmp" "$s2_key"
fi

# S2's host key is pinned in ssh.yaml, so the first `ssh s2` doesn't ask to
# trust it. ssh looks hosts up by HostName, hence the IP.
s2_hostkey={{ printf "%s %s" .ssh.s2.host .ssh.s2.hostKey | quote }}
if ! grep -qxF "$s2_hostkey" "$known_hosts"; then
  log "Trusting the S2 host key"
  printf '%s\n' "$s2_hostkey" >> "$known_hosts"
fi
{{- end }}
