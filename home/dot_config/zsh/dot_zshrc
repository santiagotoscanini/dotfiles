# ===========================================
# ~/.config/zsh/.zshrc
# Sourced only for interactive shells
# Managed by chezmoi: edit home/dot_config/zsh/dot_zshrc in the repo.
# Machine-only additions go in $ZDOTDIR/local.zsh or work.zsh (not tracked).
# ===========================================

# =========== Powerlevel10k Instant Prompt ===========
# Print a minimal prompt immediately so the shell feels responsive while the
# rest of init runs in the background. Must stay at the top: any prior code
# that prints output or reads input would be hidden behind the instant prompt
# and break it. Run `p10k configure` to customize the prompt style.
# Reference: https://github.com/romkatv/powerlevel10k#instant-prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Fix Homebrew PATH ordering issue
# macOS calls /etc/zprofile after .zshenv which adds some system paths before homebrew's.
# This ensures Homebrew binaries take precedence over system ones.
typeset -U PATH path  # Ensure PATH contains no duplicates
[[ -d /opt/homebrew/bin ]] && path=(/opt/homebrew/bin $path)

# History configuration
HISTSIZE=50000                   # Maximum events in internal history
SAVEHIST=50000                   # Maximum events in history file
setopt HIST_IGNORE_ALL_DUPS      # Don't record duplicates
setopt HIST_SAVE_NO_DUPS         # Don't write duplicates to history file
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks
setopt EXTENDED_HISTORY          # Record timestamp of command
setopt SHARE_HISTORY             # Share history between sessions
setopt HIST_IGNORE_SPACE         # Ignore commands that start with a space (useful for commands including passwords)

# Completions installed by Homebrew formulae (chezmoi, gh, …). macOS's /bin/zsh
# doesn't search there by default. Must be set before Oh-My-Zsh runs compinit.
[[ -d /opt/homebrew/share/zsh/site-functions ]] && fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

# Load additional configuration files
[[ -f $ZDOTDIR/alias.zsh ]] && source $ZDOTDIR/alias.zsh  # Load aliases

# Per-machine hooks around oh-my-zsh load. Defined in work.zsh on machines
# that need to compensate for slow fork+exec (e.g. SentinelOne EDR).
(( $+functions[_work_pre_omz_load] )) && _work_pre_omz_load
[[ -f $ZDOTDIR/oh-my.zsh ]] && source $ZDOTDIR/oh-my.zsh  # Load Oh-My-Zsh config
(( $+functions[_work_post_omz_load] )) && _work_post_omz_load

# Powerlevel10k user customization (generated by `p10k configure`).
# Lives in $ZDOTDIR because p10k follows ZDOTDIR; tracked in dotfiles so the
# same prompt style applies on every machine. Re-run `p10k configure` to update.
[[ -f $ZDOTDIR/.p10k.zsh ]] && source $ZDOTDIR/.p10k.zsh

# Local customizations (if any)
[[ -f $ZDOTDIR/local.zsh ]] && source $ZDOTDIR/local.zsh
