# ===========================================
# ~/.config/zsh/.zshenv
# Sourced on all invocations of the shell
# Managed by chezmoi: edit home/dot_config/zsh/dot_zshenv.tmpl in the repo.
# ===========================================

# =========== PATH Configuration ===========
typeset -U PATH path  # Ensure PATH contains no duplicates

# Add Cargo (Rust) binaries to PATH
[[ -d $HOME/.cargo/bin ]] && path=($HOME/.cargo/bin $path)
[[ -d /opt/homebrew/bin ]] && path=(/opt/homebrew/bin $path)
[[ -d $HOME/.local/bin ]] && path=($HOME/.local/bin $path)

# Add Postgres
[[ -d /opt/homebrew/opt/libpq/bin ]] && path=(/opt/homebrew/opt/libpq/bin $path)

# Add Claude Code
if [[ -d $HOME/.claude/local ]]; then
  path=($HOME/.claude/local $path)
elif [[ -d $HOME/.local/bin ]] && [[ -x $HOME/.local/bin/claude ]]; then
  path=($HOME/.local/bin $path)
fi

# Add obsidian
[[ -d /Applications/Obsidian.app ]] && path=(/Applications/Obsidian.app/Contents/MacOS $path)

# Add JetBrains scripts to PATH
[[ -d "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" ]] && \
  path=("$HOME/Library/Application Support/JetBrains/Toolbox/scripts" $path)

# =========== Environment Variables ===========
# Directory configurations (filled in by chezmoi from this machine's answers)
export DOTFILES_DIR={{ .chezmoi.workingTree | quote }}  # the chezmoi source repo
export DEV_DIR="$HOME/{{ .devDir }}"                     # projects: $DEV_DIR/{personal,work}
export QMK_DIR=$HOME/qmk_firmware

# Machine profile; the Brewfile reads it, so a plain `brew bundle` in the repo
# installs the same set chezmoi does.
export HOMEBREW_DOTFILES_PROFILE={{ .profile | quote }}

# Oh-My-Zsh configuration
export ZSH=$HOME/.oh-my-zsh
export ZSH_CUSTOM=$ZSH/custom    # Custom themes and plugins directory
export ZSH_COMPDUMP=$ZSH/cache/.zcompdump
export ZSH_DISABLE_COMPFIX=true  # Skip completion-dir security audit on every startup (~300ms)

# XDG Base Directory specification
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

# Go: keep its workspace out of $HOME (default ~/go); `go install` puts binaries in bin.
export GOPATH=$XDG_DATA_HOME/go
path=($GOPATH/bin $path)

# Default applications
export EDITOR='zed --wait'  # --wait: block until the file is closed
export SANTREE_EDITOR='zed'
export SANTREE_DIFF_TOOL='delta'
export VISUAL='nvim'
export PAGER='less'

# Load work-specific configurations
[[ -f $XDG_CONFIG_HOME/zsh/work.zsh ]] && source $XDG_CONFIG_HOME/zsh/work.zsh
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
