{{- /*
  chezmoi config template.

  `chezmoi init` renders this into ~/.config/chezmoi/chezmoi.toml, the only
  per-machine file. Answers are asked once and remembered; re-ask them with
  `chezmoi init --prompt`. Everything else lives in the repo.
*/ -}}

{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "work") "personal" -}}
{{- /* Only work machines are asked; it changes with the employer, so it
       lives here (per machine) instead of in the repo. */ -}}
{{- $workEmail := "" -}}
{{- if eq $profile "work" -}}
{{-   $workEmail = promptStringOnce . "workEmail" "Work email (git commits in the work folder)" -}}
{{- end -}}
{{- /* Only personal machines are asked. Yes fetches the home server's SSH key
       from Proton Pass at setup (needs a Proton login). */ -}}
{{- $s2 := false -}}
{{- if eq $profile "personal" -}}
{{-   $s2 = promptBoolOnce . "s2" "Connect this machine to the S2 home server" false -}}
{{- end -}}

# Generated by chezmoi from home/.chezmoi.toml.tmpl. Do not edit by hand:
# change the template and run `chezmoi init` to regenerate.

# The repo root (it holds .chezmoiroot, which points chezmoi at home/).
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}  # personal | work, drives Brewfile and templates
    workEmail = {{ $workEmail | quote }}  # work profile only
    s2 = {{ $s2 }}  # personal only: SSH key for the home server, from Proton Pass

# Every script sees the profile, so `brew bundle` picks the right Brewfile
# section without each script repeating it.
[scriptEnv]
    HOMEBREW_DOTFILES_PROFILE = {{ $profile | quote }}

# `chezmoi edit` must block until the file is closed.
[edit]
    command = "zed"
    args = ["--wait"]
    apply = true  # apply the file as soon as the editor closes

[diff]
    exclude = ["scripts"]  # scripts are listed by `chezmoi status`; their bodies are noise
{{- if lookPath "delta" }}
    pager = "delta"
{{- end }}

# `chezmoi add`, `edit` and `re-add` commit to the repo; pushing stays manual
# (`chezmoi git push`).
[git]
    autoCommit = true
    autoPush = false

# Turn absolute symlinks into templates when adding them, so they survive a
# different home folder or user name.
[add]
    templateSymlinks = true
